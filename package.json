{
  "name": "peacekeeper",
  "version": "0.1.0",
  "description": "RESTful API (Representational State Transfer Application Programming Interface)",
  "author": "Rivane Rasetiansyah",
  "license": "Apache-2.0",
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/rvnrstnsyh/peacekeeper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvnrstnsyh/peacekeeper.git"
  },
  "bugs": {
    "email": "vanera@nvll.cloud",
    "url": "https://github.com/rvnrstnsyh/peacekeeper/issues"
  },
  "contributors": [],
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11.11.1"
  },
  "main": "_dist/src/server.js",
  "type": "commonjs",
  "_moduleAliases": {
    "@": "_dist/src",
    "!": "_dist/tests"
  },
  "scripts": {
    "dev:node": "tsc-watch --onSuccess \"nodemon _dist/src/server.js\"",
    "dev:rust": "cargo watch --workdir sys -x run",
    "dev": "concurrently -k -n RUST,NODE \"npm run dev:rust\" \"npm run dev:node\"",
    "prod:node": "node _dist/src/server.js",
    "prod:rust": "cargo run --release --manifest-path sys/Cargo.toml",
    "prod": "concurrently -k -n RUST,NODE \"npm run prod:rust\" \"npm run prod:node\"",
    "live": "pm2 start ecosystem.config.cjs",
    "build:node": "tsc",
    "build:rust": "cargo build --release --manifest-path sys/Cargo.toml",
    "build": "npm-run-all build:rust build:node",
    "lint": "eslint . --ext .ts --ignore-pattern \"_drizzle/**\"",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:strict": "eslint . --ext .ts --max-warnings 0",
    "fmt": "prettier --write \"**/*.{js,ts,json,md,yml,yaml}\"",
    "fmt:check": "prettier --check \"**/*.{js,ts,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migration/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seed/seed.ts",
    "db:reset": "tsx src/database/seed/reset.ts",
    "logs:clean": "rm -rf logs/*",
    "key:rotate": "tsx src/shared/utils/key-manager.ts rotate",
    "key:list": "tsx src/shared/utils/key-manager.ts list",
    "gen:grpc:v0": "bash scripts/grpc-stubv0.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.9",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "module-alias": "^2.3.4",
    "nodemailer": "^8.0.8",
    "pg": "^8.21.0",
    "redis": "^5.12.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@types/handlebars": "^4.0.40",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "grpc-tools": "^1.13.1",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "ts-proto": "^2.11.8",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "diff": "^8.0.3",
    "esbuild": "^0.25.0",
    "protobufjs": "^7.5.5",
    "tar": "^7.5.3"
  }
}
