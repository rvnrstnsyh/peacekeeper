<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{appName}}</title>
  <style>
    body { margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #18181b; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header  { background: #18181b; padding: 28px 32px; }
    .header h1 { margin: 0; color: #fff; font-size: 20px; letter-spacing: .5px; }
    .body    { padding: 32px; }
    .body p  { margin: 0 0 16px; line-height: 1.6; font-size: 15px; }
    .btn     { display: inline-block; margin: 8px 0 24px; padding: 12px 28px; background: #18181b; color: #fff !important; text-decoration: none; border-radius: 6px; font-size: 15px; font-weight: 600; }
    .code    { display: inline-block; margin: 8px 0 24px; padding: 12px 24px; background: #f4f4f5; border-radius: 6px; font-family: monospace; font-size: 20px; letter-spacing: 4px; font-weight: 700; color: #18181b; }
    .footer  { padding: 20px 32px; border-top: 1px solid #f4f4f5; font-size: 12px; color: #71717a; }
    .muted   { color: #71717a; font-size: 13px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header"><h1>{{appName}}</h1></div>
    <div class="body">{{{body}}}</div>
    <div class="footer">© {{year}} {{appName}} · This is an automated message, please do not reply.</div>
  </div>
</body>
</html>
